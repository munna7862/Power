{
  "name": "india-apex-sovereign",
  "productName": "India Apex Sovereign",
  "private": true,
  "version": "1.0.0",
  "description": "India: Apex Sovereign — a realistic political and national strategy simulation.",
  "author": "India: Apex Sovereign contributors",
  "homepage": "https://github.com/munna7862/Power",
  "type": "module",
  "main": "dist-electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p electron/tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:e2e",
    "balance": "tsx tools/balance/run.ts",
    "build:electron": "tsc -p electron/tsconfig.json",
    "electron:dev": "tsx tools/electron/dev.ts",
    "electron:start": "npm run build && npm run build:electron && electron .",
    "test:electron": "npm run build && npm run build:electron && playwright test -c playwright.electron.config.ts",
    "dist": "npm run build && npm run build:electron && electron-builder --publish never",
    "dist:win": "npm run build && npm run build:electron && electron-builder --win --publish never -c.electronDist=node_modules/electron/dist",
    "icon": "tsx tools/release/icon.ts",
    "screenshots": "tsx tools/release/screenshots.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gifenc": "^1.0.3",
    "globals": "^17.13.0",
    "i18next": "^26.4.3",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
